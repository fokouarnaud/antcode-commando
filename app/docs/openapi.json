{
  "openapi": "3.0.3",
  "info": {
    "title": "AntCode Commando - E-Commerce Logistics API",
    "version": "1.0.0",
    "description": "Order lookups over the customer_neighborhood/delivery_status composite index, and the idempotent MTN MoMo / Orange Money payment webhook."
  },
  "components": {
    "securitySchemes": {
      "momoSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Momo-Signature",
        "description": "Hex-encoded HMAC-SHA256 of the raw request body, keyed with the shared MOMO_WEBHOOK_SECRET. Verifies both sender authenticity and payload integrity (a tampered body invalidates the signature)."
      },
      "orangeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Orange-Signature",
        "description": "Hex-encoded HMAC-SHA256 of the raw request body, keyed with the shared ORANGE_WEBHOOK_SECRET. Verifies both sender authenticity and payload integrity (a tampered body invalidates the signature)."
      },
      "aggregatorSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Aggregator-Signature",
        "description": "Placeholder name for whichever header the active DEFAULT_AGGREGATOR actually expects (e.g. X-Campay-Signature, X-Smobilpay-Signature) -- hex-encoded HMAC-SHA256 of the raw request body, keyed with that aggregator's own secret (e.g. CAMPAY_WEBHOOK_SECRET)."
      }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "order_id": { "type": "integer" },
          "customer_neighborhood": { "type": "string", "example": "Akwa" },
          "delivery_status": {
            "type": "string",
            "example": "Delivered",
            "enum": ["Pending", "In Transit", "Delivered", "Delayed", "Returned", "Cancelled"]
          },
          "payment_status": {
            "type": "string",
            "example": "Paid",
            "enum": ["Pending", "Paid", "Failed"]
          },
          "external_ref": { "type": "string", "example": "ECM-00001" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "per_page": { "type": "integer", "example": 20 },
          "total_records": { "type": "integer", "example": 2 },
          "total_pages": { "type": "integer", "example": 1 }
        }
      },
      "MomoCallback": {
        "type": "object",
        "required": ["order_id", "external_transaction_id", "amount_fcfa", "status"],
        "properties": {
          "order_id": { "type": "integer", "example": 1 },
          "external_transaction_id": { "type": "string", "example": "MOMO-TX-0001" },
          "amount_fcfa": { "type": "integer", "example": 15000 },
          "status": { "type": "string", "enum": ["SUCCESSFUL", "FAILED"] }
        }
      },
      "OrangeCallback": {
        "type": "object",
        "required": ["order_id", "external_transaction_id", "amount_fcfa", "status"],
        "properties": {
          "order_id": { "type": "integer", "example": 2 },
          "external_transaction_id": { "type": "string", "example": "ORANGE-TX-0001" },
          "amount_fcfa": { "type": "integer", "example": 8000 },
          "status": { "type": "string", "enum": ["SUCCESSFUL", "FAILED"] }
        }
      },
      "AggregatorCallback": {
        "type": "object",
        "required": ["order_id", "external_transaction_id", "amount_fcfa", "status"],
        "properties": {
          "order_id": { "type": "integer", "example": 1 },
          "external_transaction_id": { "type": "string", "example": "CAMPAY-TX-0001" },
          "amount_fcfa": { "type": "integer", "example": 5000 },
          "status": { "type": "string", "enum": ["SUCCESSFUL", "FAILED"] }
        }
      }
    }
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "List orders, optionally filtered by neighborhood and/or delivery status",
        "description": "Backed by idx_orders_neighborhood_status: a neighborhood-only filter uses the index's leading column, neighborhood+status uses the full composite seek.",
        "parameters": [
          {
            "name": "neighborhood",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "Akwa"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "Delayed"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-indexed page number. Defaults to 1; clamped to 1 if lower or non-numeric.",
            "schema": { "type": "integer", "default": 1 },
            "example": 1
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Rows per page. Defaults to 20; clamped to 1 if lower or non-numeric.",
            "schema": { "type": "integer", "default": 20 },
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "Matching orders, paginated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Order" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Fetch a single order by its internal id",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "404": { "description": "No order with that id" }
        }
      }
    },
    "/webhook/momo": {
      "post": {
        "summary": "MTN MoMo payment callback",
        "description": "Idempotent, keyed on (provider, external_transaction_id): replaying the same transaction id (e.g. after an MTN retry following a 3G timeout in Douala/Yaounde) returns already_processed instead of double-charging the order.",
        "security": [{ "momoSignature": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MomoCallback" }
            }
          }
        },
        "responses": {
          "200": { "description": "Processed, or already processed (idempotent replay)" },
          "401": { "description": "Missing, invalid, or payload-mismatched X-Momo-Signature" },
          "404": { "description": "order_id does not exist" }
        }
      }
    },
    "/webhook/orange": {
      "post": {
        "summary": "Orange Money payment callback",
        "description": "Idempotent, keyed on (provider, external_transaction_id): replaying the same transaction id returns already_processed instead of double-charging the order.",
        "security": [{ "orangeSignature": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrangeCallback" }
            }
          }
        },
        "responses": {
          "200": { "description": "Processed, or already processed (idempotent replay)" },
          "401": { "description": "Missing, invalid, or payload-mismatched X-Orange-Signature" },
          "404": { "description": "order_id does not exist" }
        }
      }
    },
    "/webhook/aggregator": {
      "post": {
        "summary": "Payment callback for the active aggregator (DEFAULT_AGGREGATOR)",
        "description": "Generic aggregator endpoint: routes to whichever provider DEFAULT_AGGREGATOR names (e.g. campay, smobilpay), verified with that provider's own secret and signature header from _PROVIDER_CONFIG (app/routes/webhooks.py). Same idempotency guarantee as /webhook/momo and /webhook/orange, keyed on (provider, external_transaction_id). Adding a new aggregator only means adding an entry to _PROVIDER_CONFIG -- not a new route.",
        "security": [{ "aggregatorSignature": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AggregatorCallback" }
            }
          }
        },
        "responses": {
          "200": { "description": "Processed, or already processed (idempotent replay)" },
          "401": { "description": "Missing, invalid, or payload-mismatched signature for the active aggregator" },
          "404": { "description": "order_id does not exist" },
          "500": { "description": "DEFAULT_AGGREGATOR names a provider with no entry in _PROVIDER_CONFIG (misconfiguration)" }
        }
      }
    }
  }
}
